  "schemaVersion": "2.0.0",
  "metadata": {
    "name": "Plugin skill discovery sample",
    "description": "Checks that a Microsoft 365 Copilot plugin's skills run for the prompts they should handle and stay idle otherwise. The plugin bundles a docs-research skill (Microsoft Learn) and a repository-research skill (DeepWiki). Replace expected_plugin_id with your plugin's Microsoft 365 title id and run against Microsoft 365 Copilot with the enable_a2a_skills_developer_info flight on.",
    "tags": ["plugin", "skills"]
  },
  "items": [
    {
      "prompt": "how do i set up retries on an azure function? link the docs pls",
      "evaluators": {
        "SkillDiscovery": {
          "skills": [
            {
              "expected_plugin_id": "T_397c2db6-be4b-743f-002f-9fd33f22101b",
              "expected_skill_name": "docs-research",
              "expected_outcome": "executed"
            }
          ]
        }
      },
      "evaluators_mode": "extend"
    },
    {
